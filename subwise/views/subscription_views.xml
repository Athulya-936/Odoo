<odoo>
  <record id="view_subwise_subscription_form" model="ir.ui.view">
    <field name="name">subwise.subscription.form</field>
    <field name="model">subwise.subscription</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_confirm" string="Activate" type="object" class="btn-primary"
                  invisible="state != 'draft'"/>
          <button name="action_pause" string="Pause" type="object" invisible="state != 'active'"/>
          <button name="action_cancel" string="Cancel" type="object" invisible="state in ('cancelled','draft')"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,active,paused"/>
        </header>
        <sheet>
          <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancelled'"/>
          <h1><field name="name" readonly="1"/></h1>
          <group>
            <group><field name="partner_id" required="1"/><field name="plan_id" required="1"/></group>
            <group><field name="next_billing_date"/><field name="amount_total" widget="monetary"/></group>
          </group>
          <notebook><page string="Lines"><field name="line_ids"><tree editable="bottom"/></field></page></notebook>
        </sheet>
        <div class="oe_chatter"><field name="message_ids"/></div>
      </form>
    </field>
  </record>

  <record id="view_subwise_subscription_kanban" model="ir.ui.view">
    <field name="name">subwise.subscription.kanban</field>
    <field name="model">subwise.subscription</field>
    <field name="arch" type="xml">
      <kanban default_group_by="state" quick_create="1">
        <field name="state"/>
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_global_click">
              <strong><field name="name"/></strong>
              <div><field name="partner_id"/></div>
              <field name="amount_total" widget="monetary"/>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="action_subwise_subscription" model="ir.actions.act_window">
    <field name="name">Subscriptions</field>
    <field name="res_model">subwise.subscription</field>
    <field name="view_mode">kanban,tree,form</field>
  </record>
</odoo>