<odoo>

    <record id="view_subwise_discount_list" model="ir.ui.view">
        <field name="name">subwise.discount.list</field>
        <field name="model">subwise.discount</field>
        <field name="arch" type="xml">
            <list string="Discounts">
                <field name="name"/>
                <field name="code"/>
                <field name="discount_type"/>
                <field name="value"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="used_count"/>
                <field name="is_valid"/>
            </list>
        </field>
    </record>

    <record id="view_subwise_discount_form" model="ir.ui.view">
        <field name="name">subwise.discount.form</field>
        <field name="model">subwise.discount</field>
        <field name="arch" type="xml">
            <form string="Discount">
                <sheet>
                    <group>
                        <group string="Discount Details">
                            <field name="name"/>
                            <field name="code"/>
                            <field name="discount_type"/>
                            <field name="value"/>
                        </group>

                        <group string="Validity">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="max_uses"/>
                            <field name="used_count"/>
                            <field name="is_valid"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_subwise_discount"
            model="ir.actions.act_window">
        <field name="name">Discounts</field>
        <field name="res_model">subwise.discount</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
