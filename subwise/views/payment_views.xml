<odoo>

    <record id="view_subwise_payment_list" model="ir.ui.view">
        <field name="name">subwise.payment.list</field>
        <field name="model">subwise.payment</field>
        <field name="arch" type="xml">
            <list string="Payments">
                <field name="name"/>
                <field name="subscription_id"/>
                <field name="customer_id"/>
                <field name="payment_date"/>
                <field name="amount"/>
                <field name="payment_method"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_subwise_payment_form" model="ir.ui.view">
        <field name="name">subwise.payment.form</field>
        <field name="model">subwise.payment</field>
        <field name="arch" type="xml">
            <form string="Payment">
                <header>
                    <button name="action_mark_paid"
                            type="object"
                            string="Mark as Paid"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_mark_failed"
                            type="object"
                            string="Mark as Failed"
                            invisible="state != 'draft'"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,paid,failed"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="subscription_id"/>
                            <field name="customer_id" readonly="1"/>
                        </group>

                        <group>
                            <field name="amount"/>
                            <field name="payment_date"/>
                            <field name="payment_method"/>
                            <field name="transaction_reference"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_subwise_payment"
            model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">subwise.payment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
